# ====================================================================
# macOS / OS X System Files
# ====================================================================

# Core system database storing folder view settings and icons
.DS_Store

# Extended attributes file containing custom folder icons
.AppleDouble

# Folder configuration file created when accessing shared network folders
.LSOverride

# Files created by macOS when viewing folders on external USB drives
.Spotlight-V100
.Trashes

# Hidden system files used for directory event tracking
.DocumentRevisions-V100
.fseventsd

# Thumbnail cache files generated by the Finder or third-party apps
._*
.VolumeIcon.icns

# Files created by the macOS built-in unzip/compression tool
.AppleDB
.AppleDesktop
Network Trash Folder
Temporary Items

# ====================================================================
# Common Development IDEs (Optional but recommended for macOS devs)
# ====================================================================

# Xcode and AppCode settings
*.mode1v3
*.mode2v3
*.storyboardc

# VS Code settings that shouldn't be shared
.vscode/

# JetBrains / IntelliJ / PyCharm / WebStorm project settings
.idea/
.claude/

*.zip
CHROMEWEBSTORE.md
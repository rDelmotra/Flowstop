{
  "manifest_version": 3,
  "name": "Flowstop",
  "version": "0.2",
  "description": "True offline mode for specific browser tabs",
  "permissions": [
    "debugger",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}

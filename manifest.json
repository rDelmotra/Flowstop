{
  "manifest_version": 3,
  "name": "Flowstop: Tab Blocker & Offline Mode",
  "short_name": "Flowstop",
  "version": "1.0",
  "description": "True offline mode for specific browser tabs",
  "icons": {
    "16": "iconme.png",
    "32": "iconme.png",
    "48": "iconme.png",
    "128": "iconme.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Open Flowstop popup"
    }
  }
}
